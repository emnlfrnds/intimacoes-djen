# Copie para .env (cp .env.example .env) e preencha DB_PASS e API_KEY
PORT=3000
DB_HOST=localhost
DB_PORT=5435
DB_USER=djen
DB_PASS=troque-esta-senha
DB_NAME=djen
DJEN_BASE_URL=https://comunicaapi.pje.jus.br/api/v1
DJEN_TIMEOUT_MS=30000
# true: se a API falhar de vez, o sync usa mocks/djen.json
DJEN_FALLBACK_MOCK=true
# Canais do alerta, separados por vírgula: sse, discord
NOTIFICACAO_CANAIS=sse
DISCORD_WEBHOOK_URL=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=
# Origens que podem chamar a API pelo navegador, separadas por vírgula
CORS_ORIGENS=http://localhost:3000